{
  "manifest_version": 3,
  "name": "Local to Web Studio Syncer",
  "version": "1.0",
  "description": "Syncs local files to web studio editor to fix reverse diff issues.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*"
  ],
  "action": {
    "default_title": "AI Studio Syncer"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["src/content.js"]
    },
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["src/page-context.js"],
      "world": "MAIN"
    }
  ]
}
